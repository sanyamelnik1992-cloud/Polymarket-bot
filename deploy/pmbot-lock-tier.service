[Unit]
Description=pmbot TWAP-lock L3 price tiers (config/lock_tier.toml: L with price tiers: lower probability only at a cheaper ask; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/47. Compare with pmbot-lock (L) on the same windows; L is what pmbot-lock-live runs.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock_tier.toml
# CPU priority: paper bots yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
