[Unit]
Description=pmbot TWAP-lock LM3 (config/lock_maker_tier.toml: the L3 price tiers as a resting bid instead of a taker buy; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/52. Maker twin of pmbot-lock-tier (the L3 tiers, entry = maker). Queue-model fills: a lower bound.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock_maker_tier.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
