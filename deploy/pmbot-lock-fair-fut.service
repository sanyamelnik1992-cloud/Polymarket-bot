[Unit]
Description=pmbot fair-value taker on 5m, futures signal (config/lock_fair_fut.toml: the A/B of pmbot-lock-fair; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/83. The book lags Binance: the side whose ask is >= 0.15 below its Binance fair value, one entry per window.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock_fair_fut.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
