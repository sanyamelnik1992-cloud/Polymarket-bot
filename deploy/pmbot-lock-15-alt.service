[Unit]
Description=pmbot TWAP-lock L3 on 15m, more coins (config/lock15_alt.toml: the 15-minute rule on DOGE, BNB, HYPE; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/73. The 15m rule of pmbot-lock-15-tier on DOGE, BNB, HYPE.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock15_alt.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
