[Unit]
Description=pmbot liquidity-rewards farmer R (config/rewards.toml, paper; reports/68)
After=network-online.target
Wants=network-online.target
# a crash-loop must not keep re-entering the market: give up after 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER only (the config loader refuses anything else). Not enabled at boot: /restart pmbot-rewards in Telegram.
# Report: scripts/report_rewards.py data/journal-rewards (also runs/pmbot-rewards.txt in the hourly server report)
ExecStart=__REPO__/.venv/bin/python scripts/run_rewards.py --config config/rewards.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
