[Unit]
Description=pmbot liquidity-rewards farmer R (config/rewards.toml, paper)
After=network-online.target
Wants=network-online.target
# a crash-loop must not keep re-entering the market: give up after 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER only (the config loader refuses anything else). Start once with:  sudo systemctl enable --now pmbot-rewards
# (or /restart pmbot-rewards in Telegram). Report: scripts/report_rewards.py data/journal-rewards
ExecStart=__REPO__/.venv/bin/python scripts/run_rewards.py --config config/rewards.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
