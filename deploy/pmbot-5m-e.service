[Unit]
Description=pmbot 5m maker E (config/live_d_twin.toml = paper twin of the live bot)
After=network-online.target
Wants=network-online.target
# a crash-loop must not keep re-entering the market: give up after 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER twin of pmbot-5m-live: identical config, simulated execution.
ExecStart=__REPO__/.venv/bin/python scripts/run_bot.py --config config/live_d_twin.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=1500

[Install]
WantedBy=multi-user.target
