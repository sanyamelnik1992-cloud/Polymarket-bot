[Unit]
Description=pmbot: push the hourly server report to the server-reports branch on GitHub
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__
# low priority: the hourly report (pandas over every journal) ran at the default weight at :00 every hour, next to the live
# bots whose orders took 2.5-3 s for every tenth on 22 Nov (reports/83 section 14)
Nice=19
CPUWeight=10
IOSchedulingClass=idle
# 26 Nov: the scheduler's IDLE class, it runs only when a CPU has nothing else to do (the live maker's place / cancel took 152 / 187 ms
# on a server 60 % busy; this job read every journal with pandas at :02 every hour)
CPUSchedulingPolicy=idle
ExecStart=/bin/bash __REPO__/deploy/push_reports.sh
TimeoutStartSec=600
