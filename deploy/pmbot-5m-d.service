[Unit]
Description=pmbot 5m maker D (config/colo_strict.toml = B with max_disagree 0.04, paper)
After=network-online.target
Wants=network-online.target
# a crash-loop must not keep re-entering the market: give up after 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. Strict variant for a paired test next to its parent unit (see the config header).
# For live: --config config/live.toml --live  (and PMBOT_LIVE_CONFIRM in the env file)
ExecStart=__REPO__/.venv/bin/python scripts/run_bot.py --config config/colo_strict.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=1500

[Install]
WantedBy=multi-user.target
