[Unit]
Description=pmbot TWAP-lock L4 price tiers, floor 0.50 (config/lock_tier_wide.toml: L with price tiers: lower probability only at a cheaper ask; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/47. Compare with pmbot-lock-tier (L3) on the same windows; riskier than L3.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock_tier_wide.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
