[Unit]
Description=pmbot TWAP-lock early sniper on 15m (config/lock15_early.toml: the leader 300-120 s before the end at 0.985-0.99; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/80, reports/81: the early 0.99 rule, measured on paper before any real money.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock15_early.toml
# CPU priority: paper bots yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
