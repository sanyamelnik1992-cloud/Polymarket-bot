[Unit]
Description=pmbot TWAP-lock L99 (config/lock_99.toml: the sure side at asks 0.96-0.99, the competitor zone; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/55. p >= 0.99 on the unfloored model, asks 0.96-0.99.
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock_99.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
