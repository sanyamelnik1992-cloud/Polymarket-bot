[Unit]
Description=pmbot hourly crypto taker (config/hourly.toml by default)
After=network-online.target
Wants=network-online.target
# a crash-loop must not keep re-entering the market: give up after 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER by default. For live: --config config/hourly_live.toml --live  (and PMBOT_LIVE_CONFIRM in the env file)
ExecStart=__REPO__/.venv/bin/python scripts/run_hourly.py --config config/hourly.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=1500

[Install]
WantedBy=multi-user.target
