# /etc/pmbot/pmbot.env  (chmod 600). Read by the systemd units. Never commit real values.
# --- auto-update: the branch the server follows (deploy/autoupdate.sh, every 2 min) ---
PMBOT_BRANCH=main
# --- live trading only (leave empty for paper) ---
PMBOT_PRIVATE_KEY=
PMBOT_WALLET=
# PMBOT_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY_RISK
# --- Telegram (scripts/tg_bot.py, unit pmbot-tg; alerts from the bots) ---
PMBOT_TG_TOKEN=
PMBOT_TG_CHAT=
PMBOT_TG_DIGEST_MIN=60
# --- disk housekeeping (deploy/cleanup.sh) ---
PMBOT_REC_KEEP_HOURS=12
PMBOT_MIN_FREE_GB=3
