[Unit]
Description=pmbot TWAP-lock L (config/lock15.toml: L on the 15-minute markets; paper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER. reports/44_twap_lock.md. 15m twin of pmbot-lock (same rule, duration 900).
ExecStart=__REPO__/.venv/bin/python scripts/run_lock.py --config config/lock15.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
