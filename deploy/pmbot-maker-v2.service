[Unit]
Description=pmbot Мейкер v2 5 мин (config/maker_v2.toml: favourite-skewed bids, Binance gate, from second 100; paper twin of the live test, reports/95)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/pmbot/pmbot.env
# PAPER ONLY (the loader refuses live). reports/95. Started once by install_units.sh (START_ONCE).
ExecStart=__REPO__/.venv/bin/python scripts/run_maker.py --config config/maker_v2.toml
# CPU priority: paper/recorder yield to the live bots when the 2 vCPU are busy (load 3.0 on 9 Nov, G loop lag 17 s)
Nice=10
CPUWeight=20
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
